;; Many try_tables open at once: every level of a recursion keeps one open,
;; with 40 locals each, so the handler records and the locals arena both
;; outgrow their first allocation, and the stack grows. Locals set inside a
;; try_table's body must be seen by its handler.
(module
  (tag $e (param i32))
  (tag $other)

  ;; Returns $n: each level throws (deeper result + 1) to its own handler,
  ;; which checks its locals.
  (func $nest (param $n i32) (result i32)
    (local $v i32) (local $l0 i64) (local $l1 i64) (local $l2 i64) (local $l3 i64) (local $l4 i64) (local $l5 i64) (local $l6 i64) (local $l7 i64) (local $l8 i64) (local $l9 i64) (local $l10 i64) (local $l11 i64) (local $l12 i64) (local $l13 i64) (local $l14 i64) (local $l15 i64) (local $l16 i64) (local $l17 i64) (local $l18 i64) (local $l19 i64) (local $l20 i64) (local $l21 i64) (local $l22 i64) (local $l23 i64) (local $l24 i64) (local $l25 i64) (local $l26 i64) (local $l27 i64) (local $l28 i64) (local $l29 i64) (local $l30 i64) (local $l31 i64) (local $l32 i64) (local $l33 i64) (local $l34 i64) (local $l35 i64) (local $l36 i64) (local $l37 i64) (local $l38 i64) (local $l39 i64)
