  (func (export "nest") (param $depth i32) (result i32)
    (call $nest (local.get $depth)))

  ;; Returns 5 plus a local set inside the body.
  (func (export "pass") (param $depth i32) (result i32)
    (local $inside i32)
    (block $caught (result i32)
      (try_table (catch $e $caught)
        (local.set $inside (i32.const 1000))
